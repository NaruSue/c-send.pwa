{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-remote",
  "description": "Official c-send PWA permissions",
  "windows": ["main"],
  "remote": { "urls": ["https://narusue.github.io/c-send.pwa", "https://narusue.github.io/c-send.pwa/*"] },
  "permissions": ["core:event:default", "core:window:allow-set-title", "allow-desktop-get-info", "allow-desktop-publish-quick-list", "allow-desktop-respond-template", "allow-desktop-set-always-on-top"]
}
